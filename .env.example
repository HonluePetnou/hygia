# Copier en .env puis adapter. Aucune valeur réelle ne doit être commitée.

# Bases PostgreSQL (+ pgvector), une par service, via docker compose (port hôte 54320)
HYGIA_POSTGRES_PORT=54320
# Dossiers : absente, données en mémoire ; `pnpm --filter dossiers db:migrate` crée le schéma
DOSSIERS_DATABASE_URL=postgresql://hygia:hygia@localhost:54320/dossiers

# AWS simulé par LocalStack (aucun compte AWS nécessaire en local)
AWS_REGION=eu-west-3
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Ressources créées au démarrage de LocalStack (infra/localstack/init.sh)
S3_BUCKET_DOCUMENTS=hygia-documents
S3_BUCKET_AUDIT=hygia-audit
SQS_QUEUE_INGESTION=hygia-ingestion.fifo
SNS_TOPIC_ALERTES=hygia-alertes

# IA : "mock" en local ; "bedrock" une fois le modèle choisi (section 8.1 du cahier)
LLM_PROVIDER=mock
BEDROCK_MODEL_ID=

# Ports des services
DOSSIERS_PORT=3001
INGESTION_PORT=3002
IA_CLINIQUE_PORT=3003
WEB_PORT=3000

# Broker : point d'entrée unique ; registre de services (équivalent local de Cloud Map)
BROKER_PORT=3000
BROKER_SERVICE_DOSSIERS_URL=http://localhost:3001
BROKER_SERVICE_IA_CLINIQUE_URL=http://localhost:3003
# BROKER_SERVICE_<AUDIT|INGESTION|NOTIFICATION|SYNCHRONISATION|IDENTITE|AGENTS>_URL=...
BROKER_TIMEOUT_MS=5000
BROKER_RATE_LIMIT=300
BROKER_RATE_WINDOW_MS=60000

# Client web (apps/web) : le broker est la seule adresse connue du client
NEXT_PUBLIC_API_URL=http://localhost:3000
# 1 = données en mémoire, sans aucun service (démo hors ligne)
NEXT_PUBLIC_DEMO_OFFLINE=1

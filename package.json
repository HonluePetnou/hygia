{
  "name": "hygia",
  "private": true,
  "description": "Plateforme répartie d'analyse des dossiers patients sur AWS, augmentée par l'IA",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo.mjs",
    "package:usb": "node scripts/package-usb.mjs",
    "docs:pdf": "node scripts/docs-pdf.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "marked": "18.1.3",
    "mermaid": "12.3.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}

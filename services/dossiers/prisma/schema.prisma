// Schéma PostgreSQL du service Dossiers. Le service possède ses données ; aucune table n'est
// partagée avec un autre service. Les ressources FHIR sont stockées entières en JSONB (comme les
// serveurs FHIR courants), indexées par patient : voir docs/adr/0002-persistance-dossiers.md.
// URL de connexion : prisma.config.ts (DOSSIERS_DATABASE_URL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Ressource FHIR (Patient, Encounter, Observation, DocumentReference…), versionnée.
model FhirResource {
  resourceType String   @map("resource_type")
  id           String
  /// Patient concerné ; null pour les ressources partagées (établissements, praticiens, équipes).
  patientId    String?  @map("patient_id")
  version      Int
  body         Json     @db.JsonB
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@id([resourceType, id])
  @@index([patientId])
  @@map("fhir_resource")
}

{
  "name": "@hygia/infra-cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Infrastructure AWS de HYGIA en code (AWS CDK) : synthèse hors ligne, sans compte AWS",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "synth": "tsc -p tsconfig.build.json && cdk synth --quiet",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "2.1147.0",
    "vitest": "^5.1.0"
  }
}
